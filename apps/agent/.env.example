# Neon PostgreSQL connection string (asyncpg format)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-hostname.region.aws.neon.tech/neondb?ssl=require

# OpenAI API Key for multi-agent synthesis & reasoning
OPENAI_API_KEY=sk-...

# Secret key shared between REST API (Vercel) and Agent engine (Render)
AGENT_INTERNAL_SECRET=change-this-to-a-cryptographically-random-secret-in-production

# Enable background queue consumer to process queued jobs (true/false)
ENABLE_QUEUE_POLLER=true
AGENT_POLL_INTERVAL_SECONDS=8

# Database pool settings
DB_USE_NULL_POOL=true
PORT=8001
