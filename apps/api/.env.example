# Neon PostgreSQL connection string (asyncpg format)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-hostname.region.aws.neon.tech/neondb?ssl=require

# OpenAI API Key for suggestions generation
OPENAI_API_KEY=sk-...

# Cryptographically random HMAC session signing key (required)
SESSION_SECRET=change-this-to-a-cryptographically-random-secret-in-production

# Agent service endpoint on Render
AGENT_SERVICE_URL=https://noesis-agent.onrender.com

# Shared secret key authenticating webhook calls to the Render agent service
AGENT_INTERNAL_SECRET=change-this-to-a-cryptographically-random-secret-in-production

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://noesis.hetav.dev,http://localhost:3000,http://localhost:3001
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://.*\.vercel\.app$|^https://noesis\.hetav\.dev$

# Session cookie configuration
SESSION_COOKIE_NAME=noesis_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Rate limit thresholds
MAX_CONCURRENT_JOBS_PER_SESSION=1
RATE_LIMIT_JOBS_PER_HOUR=5
TRUST_ALL_PROXIES=false
DB_USE_NULL_POOL=true
