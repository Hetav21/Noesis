# OpenAI API Credentials
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
# Standard postgres:// and postgresql:// URLs are automatically normalized to postgresql+asyncpg://
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# SQL_ECHO=false

# ==========================================
# Server & CORS Configuration
# ==========================================
# Comma-separated list of allowed origins (e.g. your Vercel deployment URL)
# ALLOWED_ORIGINS=https://noesis-web.vercel.app,https://yourcustomdomain.com
# Regular expression for matching dynamic origins (defaults to localhost and *.vercel.app)
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://.*\.vercel\.app$

# ==========================================
# Session & Rate Limiting Configuration
# ==========================================
# Cryptographically random secret key used for signing session cookies with HMAC-SHA256 (REQUIRED, generate via `openssl rand -hex 32`)
SESSION_SECRET=
# SESSION_COOKIE_NAME=noesis_session
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=true
# Maximum number of concurrent active jobs per session/IP (default 1)
MAX_CONCURRENT_JOBS_PER_SESSION=1
# Maximum number of research jobs per hour per session/IP (default 5)
RATE_LIMIT_JOBS_PER_HOUR=5

# ==========================================
# Agent Configuration Settings
# ==========================================
#
# Available OpenAI Models:
# - gpt-4o (highly capable, recommended for synthesis)
# - gpt-4o-mini (fast and cost-effective, default for helper agents)
# - o1-preview / o1-mini (reasoning models)
#
# Available LLM Parameters:
# - MODEL: Model identifier string from OpenAI's catalog.
# - TEMPERATURE: Sampling temperature (0.0 to 2.0). Default is 1.0. Lower values are more deterministic.
# - TOP_P: Nucleus sampling probability (0.0 to 1.0). Default is 1.0.
# - TOP_K: Number of highest probability vocabulary tokens to keep. (Not supported by OpenAI).
# - MAX_TOKENS: Maximum number of tokens to generate.
# - PRESENCE_PENALTY: Positive values penalize new tokens based on presence in text so far. Default is 0.0.
# - FREQUENCY_PENALTY: Positive values penalize new tokens based on their frequency in text so far. Default is 0.0.

# 1. Query Generator Agent Configuration (Breaks down queries into search tasks)
QUERY_AGENT_MODEL=gpt-4o-mini
QUERY_AGENT_TEMPERATURE=0.7  # Default 1.0 — lowered for focused yet diverse query generation without incoherent outputs
QUERY_AGENT_TOP_P=1.0
# QUERY_AGENT_TOP_K=
# QUERY_AGENT_MAX_TOKENS=
QUERY_AGENT_PRESENCE_PENALTY=0.0
QUERY_AGENT_FREQUENCY_PENALTY=0.0

# 2. Search Agent Configuration (Scrapes & Summarizes web results)
SEARCH_AGENT_MODEL=gpt-4o-mini
SEARCH_AGENT_TEMPERATURE=0.2  # Default 1.0 — low for faithful, deterministic summarization that stays true to source content
SEARCH_AGENT_TOP_P=1.0
# SEARCH_AGENT_TOP_K=
# SEARCH_AGENT_MAX_TOKENS=
SEARCH_AGENT_PRESENCE_PENALTY=0.0
SEARCH_AGENT_FREQUENCY_PENALTY=0.0

# 3. Follow-up Decision Agent Configuration (Determines if more research is required)
FOLLOW_UP_AGENT_MODEL=gpt-4o-mini
FOLLOW_UP_AGENT_TEMPERATURE=0.2  # Default 1.0 — low for consistent, deterministic decision-making (binary yes/no output)
FOLLOW_UP_AGENT_TOP_P=1.0
# FOLLOW_UP_AGENT_TOP_K=
# FOLLOW_UP_AGENT_MAX_TOKENS=
FOLLOW_UP_AGENT_PRESENCE_PENALTY=0.0
FOLLOW_UP_AGENT_FREQUENCY_PENALTY=0.0

# 4. Synthesis Agent Configuration (Compiles all findings into a final report)
SYNTHESIS_AGENT_MODEL=gpt-4o
SYNTHESIS_AGENT_TEMPERATURE=0.7  # Default 1.0 — moderate for fluent, engaging long-form report writing
SYNTHESIS_AGENT_TOP_P=1.0
# SYNTHESIS_AGENT_TOP_K=
# SYNTHESIS_AGENT_MAX_TOKENS=
SYNTHESIS_AGENT_PRESENCE_PENALTY=0.0
SYNTHESIS_AGENT_FREQUENCY_PENALTY=0.0
