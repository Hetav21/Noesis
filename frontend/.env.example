# Noesis Frontend Environment Variables

# Backend API server URL for Next.js rewrites (/api/:path* -> BACKEND_URL/api/:path*)
# In local development: http://localhost:8000
# In production (e.g. deployed on Vercel): https://your-backend-domain.com
BACKEND_URL=http://localhost:8000

# Optional: Direct client-side API base URL override
# NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api
